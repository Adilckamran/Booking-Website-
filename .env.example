# ==============================================================================
# PADEL COURT BOOKING SYSTEM - ENVIRONMENT CONFIGURATION (PLACEHOLDER TEMPLATE)
# Copy this file to .env.local for local development.
# NEVER commit real credentials, service-role keys, or tokens to version control.
# ==============================================================================

# NEXT.JS APPLICATION
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=development

# CLUB BUSINESS DETAILS (PLACEHOLDERS)
NEXT_PUBLIC_CLUB_NAME="[CONFIGURABLE CLUB NAME]"
NEXT_PUBLIC_CLUB_PHONE="+92 300 0000000"
NEXT_PUBLIC_WHATSAPP_NUMBER="923000000000"

# SUPABASE (FOR PHASE 2+)
# Public Anon Key: Safe for browser use with Row Level Security (RLS)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-placeholder

# SUPABASE SERVICE ROLE KEY (SERVER-SIDE ONLY - NEVER EXPOSE TO CLIENT)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-placeholder
SUPABASE_STORAGE_BUCKET_RECEIPTS=receipts-private

# WHATSAPP BUSINESS PLATFORM CLOUD API (SERVER-SIDE ONLY - FOR PHASE 10+)
WHATSAPP_CLOUD_API_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id-placeholder
WHATSAPP_BUSINESS_ACCOUNT_ID=your-business-account-id-placeholder
WHATSAPP_SYSTEM_USER_ACCESS_TOKEN=your-whatsapp-access-token-placeholder
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-custom-webhook-verify-token-placeholder

# ADMIN AUTHENTICATION SECRET (FOR PHASE 7+)
ADMIN_SESSION_SECRET=generate-a-strong-32-byte-secret-for-session-cookies
