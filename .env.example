# ==============================================================================
# POWER PADEL ARENA - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env.local for local development.
# IMPORTANT: .env.local is ignored by Git. NEVER commit real credentials,
# service-role keys, or private tokens to version control.
# ==============================================================================

# NEXT.JS APPLICATION
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=development

# ==============================================================================
# SUPABASE CONFIGURATION
# Obtain these from: Supabase Dashboard -> Project Settings -> API
# ==============================================================================

# 1. Project URL (Public)
NEXT_PUBLIC_SUPABASE_URL=https://qckfldbnwifwjlhabhzk.supabase.co

# 2. Public Publishable Key / Anon Key (Safe for browser client with RLS)
# You can use either NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY or NEXT_PUBLIC_SUPABASE_ANON_KEY
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-placeholder
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-placeholder

# 3. Server-Side Secret Key (STRICTLY SERVER-SIDE - NEVER EXPOSE VIA NEXT_PUBLIC_)
# Supports either the classic service_role JWT key (starts with eyJ...) 
# or the modern Supabase secret key (starts with sb_secret_...)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-or-secret-key-placeholder
# SUPABASE_SECRET_KEY=your-supabase-secret-key-placeholder

# 4. Storage Bucket Configuration
SUPABASE_STORAGE_BUCKET_RECEIPTS=receipts-private

# ==============================================================================
# EMAIL NOTIFICATIONS (GMAIL SMTP - STRICTLY SERVER-SIDE)
# ==============================================================================
# Sender address (allowlisted administrator account)
GMAIL_USER=thepowerpadel@gmail.com
# Google Account App Password (16 characters, generated in myaccount.google.com/apppasswords)
GMAIL_APP_PASSWORD=your-gmail-16-char-app-password-placeholder
# Optional custom SMTP configuration:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=thepowerpadel@gmail.com
# SMTP_PASS=your-smtp-password-placeholder

# ==============================================================================
# WHATSAPP BUSINESS PLATFORM CLOUD API (STRICTLY SERVER-SIDE)
# ==============================================================================
WHATSAPP_CLOUD_API_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id-placeholder
WHATSAPP_BUSINESS_ACCOUNT_ID=your-business-account-id-placeholder
WHATSAPP_ACCESS_TOKEN=your-whatsapp-system-user-access-token-placeholder
# WHATSAPP_CONFIRMATION_TEMPLATE=booking_confirmation
# WHATSAPP_REJECTION_TEMPLATE=booking_rejection
